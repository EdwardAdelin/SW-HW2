<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/homework/bookrec#"
     xml:base="http://www.semanticweb.org/homework/bookrec"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/homework/bookrec"/>

    <!-- Properties -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/homework/bookrec#hasTheme"/>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/homework/bookrec#suitableFor"/>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/homework/bookrec#prefersTheme"/>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/homework/bookrec#hasReadingLevel"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://www.semanticweb.org/homework/bookrec#Book"/>
    <owl:Class rdf:about="http://www.semanticweb.org/homework/bookrec#Theme"/>
    <owl:Class rdf:about="http://www.semanticweb.org/homework/bookrec#User"/>
    <owl:Class rdf:about="http://www.semanticweb.org/homework/bookrec#ReadingLevel"/>

    <!-- Reading Levels -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Advanced">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#ReadingLevel"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Beginner">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#ReadingLevel"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Intermediate">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#ReadingLevel"/>
    </owl:NamedIndividual>

    <!-- Themes -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Fantasy">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Theme"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Mystery">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Theme"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#ScienceFiction">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Theme"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Murder">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Theme"/>
    </owl:NamedIndividual>

    <!-- Users -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Alice">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#User"/>
        <prefersTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#ScienceFiction"/>
        <hasReadingLevel rdf:resource="http://www.semanticweb.org/homework/bookrec#Intermediate"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Bob">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#User"/>
        <prefersTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#Mystery"/>
        <hasReadingLevel rdf:resource="http://www.semanticweb.org/homework/bookrec#Beginner"/>
    </owl:NamedIndividual>

    <!-- Books -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#Dune">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Book"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#Fantasy"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#ScienceFiction"/>
        <suitableFor rdf:resource="http://www.semanticweb.org/homework/bookrec#Advanced"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#HungerGames">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Book"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#Fantasy"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#ScienceFiction"/>
        <suitableFor rdf:resource="http://www.semanticweb.org/homework/bookrec#Beginner"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/homework/bookrec#TheSilentPatient">
        <rdf:type rdf:resource="http://www.semanticweb.org/homework/bookrec#Book"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#Mystery"/>
        <hasTheme rdf:resource="http://www.semanticweb.org/homework/bookrec#Murder"/>
        <suitableFor rdf:resource="http://www.semanticweb.org/homework/bookrec#Intermediate"/>
    </owl:NamedIndividual>
</rdf:RDF>